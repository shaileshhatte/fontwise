{
    "manifest_version": 3,
    "name": "__MSG_extFullName__",
    "short_name": "__MSG_extName__",
    "version": "1.0.0",
    "description": "__MSG_extDescription__",
    "default_locale": "en",
    "homepage_url": "https://github.com/shaileshhatte/fontwise",
    "minimum_chrome_version": "121",
    "icons": {
        "16": "icons/16.png",
        "32": "icons/32.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    },
    "background": {
        "service_worker": "scripts/background.js",
        "scripts": [
            "shared/settings.js",
            "shared/catalog.js",
            "shared/store.js",
            "scripts/background.js"
        ]
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "__MSG_extName__",
        "default_icon": {
            "16": "icons/16.png",
            "32": "icons/32.png",
            "48": "icons/48.png",
            "128": "icons/128.png"
        }
    },
    "options_ui": {
        "page": "options/options.html",
        "open_in_tab": true
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+Shift+F"
            },
            "description": "__MSG_cmdOpenPopup__"
        },
        "toggle-fontwise": {
            "suggested_key": {
                "default": "Alt+Shift+P"
            },
            "description": "__MSG_cmdToggle__"
        },
        "apply-best": {
            "suggested_key": {
                "default": "Alt+Shift+R"
            },
            "description": "__MSG_cmdBest__"
        },
        "toggle-focus-mode": {
            "suggested_key": {
                "default": "Alt+Shift+B"
            },
            "description": "__MSG_cmdFocus__"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "shared/bundled-fonts.js",
                "shared/settings.js",
                "shared/css.js",
                "scripts/content.js"
            ],
            "run_at": "document_start",
            "all_frames": false
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "fonts/*"
            ],
            "matches": [
                "http://*/*",
                "https://*/*"
            ]
        }
    ],
    "permissions": [
        "storage",
        "scripting"
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "fontwise@shailesh-hatte",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    }
}